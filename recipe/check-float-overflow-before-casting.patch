+def test_float_buffer_integer_boundaries():
+    # Use Python integers as an independent oracle for the buffer conversion.
+    upper = 2 ** (sizeof_c_long * 8 - 1)
+    for dtype in [np.float32, np.float64, np.longdouble]:
+        bound = dtype(upper)
+        valid = [dtype(0), dtype(-0.0), dtype(1.75), dtype(-1.75),
+                 -bound, np.nextafter(bound, dtype(0)),
+                 np.nextafter(-bound, dtype(0))]
+        for value in valid:
+            assert ta.array(np.array(value), int) == int(value)
+            assert ta.array(np.array([value]), int) == [int(value)]
+        for value in [bound, np.nextafter(bound, dtype(np.inf)),
+                      np.nextafter(-bound, dtype(-np.inf)),
+                      dtype(np.inf), dtype(-np.inf)]:
+            raises(OverflowError, ta.array, np.array(value), int)
+            raises(OverflowError, ta.array, np.array([value]), int)
+        raises(ValueError, ta.array, np.array(dtype(np.nan)), int)
+        raises(ValueError, ta.array, np.array([dtype(np.nan)]), int)
